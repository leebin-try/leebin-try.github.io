{
  "name": "demo-personal-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "typecheck": "astro check",
    "preview:test": "astro preview --host 127.0.0.1 --port 4329 --ignore-lock",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:design": "playwright test --project=design",
    "test:browser": "playwright test",
    "check:content": "python3 scripts/check-translations.py && python3 scripts/check-kaggle-assets.py",
    "check:design": "npm run build && npm run test:design",
    "check": "npm run typecheck && npm run build && npm run check:content && npm run test:browser"
  },
  "dependencies": {
    "astro": "^7.4.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.58.0",
    "typescript": "^6.0.3"
  }
}
