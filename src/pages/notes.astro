---
import BaseLayout from '@/layouts/BaseLayout.astro';
const notes = [{ date: '2026.11.13', title: '给想法留一点空白', text: '今天的提醒：页面可以留白，日程也可以。不是每一个空隙都需要被信息填满。', tag: '日常观察' }, { date: '2026.11.10', title: '工具的边界', text: '一个好工具，不必解决所有问题。把一件小事做好，让使用它的人少想一步，就已经很有价值。', tag: '关于构建' }, { date: '2026.11.06', title: '先开始，再慢慢完善', text: '一篇没有写完的文章，胜过十个还没创建的文件夹。先记录一个真实的问题，再去寻找更好的表达。', tag: '写作碎片' }];
---
<BaseLayout title="手记"><section class="notes-page shell"><div class="page-heading"><span class="section-eyebrow-label">SMALL THOUGHTS, QUIET MOMENTS</span><h1>长文章之外，<br/>还有一些小事<span class="accent-dot">。</span></h1><p>不一定完整，但值得记下。以下为演示手记。</p></div><div class="notes-list">{notes.map((note,index) => <article class="note-entry"><div class="note-number">{String(index+1).padStart(2,'0')}</div><div><div class="post-meta"><span>{note.tag}</span><time>{note.date}</time></div><h2>{note.title}</h2><p>{note.text}</p><span class="note-end">↳ NOTE TO SELF</span></div></article>)}</div></section></BaseLayout>
