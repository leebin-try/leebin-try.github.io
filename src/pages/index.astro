---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts, formatDate, readingTime, coverSource, coverAlt } from '@/utils/posts';
import { categories } from '@/config';
import '@/styles/research-report.css';
import '@/styles/kaggle.css';
const posts = await getPosts();
const featured = posts.find(post => post.data.featured) ?? posts[0];
const latest = posts.filter(post => post.id !== featured?.id).slice(0, 6);
const kagglePosts = posts.filter(post => post.data.kaggle);
const cases = kagglePosts.filter(post => post.data.kaggle?.kind === 'case');
---
<BaseLayout>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-eyebrow"><span class="status-dot"></span> A PERSONAL JOURNAL <span class="hero-vol">EST. 2026 / VOL. 01</span></div>
    <div class="hero-content"><div><h1 id="hero-title">保持好奇，<br/>持续<span class="hero-emphasis">构建<svg viewBox="0 0 240 14" aria-hidden="true"><path d="M4 10Q110-2 236 6"/></svg></span>。</h1><div class="hero-bottom"><span class="hero-label">TECHNOLOGY</span><span class="little-cross">+</span><span class="hero-label">DESIGN</span><span class="little-cross">+</span><span class="hero-label">LIFE</span></div></div><div class="hero-intro"><span class="intro-symbol" aria-hidden="true">↘</span><p>在代码与日常之间，<br/>记录思考，分享发现。<br/>这里是一处缓慢生长的数字花园。</p><a class="text-link" href="/about/">很高兴认识你 <Icon name="arrow" size={17}/></a></div></div>
  </section>
  {featured && <section class="featured-section shell" aria-labelledby="featured-title"><div class="section-eyebrow"><span>THE FEATURED STORY</span><span>精选 · 01</span></div><a class="featured-story" href={`/posts/${featured.id}/`}><div class="featured-art"><img src={coverSource(featured)} class:list={{ 'editorial-cover': Boolean(featured.data.coverImage) }} alt={coverAlt(featured)} width="1000" height="760" fetchpriority="high"/><span class="art-caption">IDEAS TAKE ROOT.</span><span class="art-mark" aria-hidden="true">✳</span></div><div class="featured-copy"><div class="featured-kicker"><span class="category"><i></i>{featured.data.category}</span>{featured.data.sample && <span class="sample-badge">示例文章</span>}</div><h2 id="featured-title">{featured.data.title}</h2><p>{featured.data.description}</p><div class="featured-bottom"><span>{formatDate(featured.data.date)}<span class="meta-sep">/</span>{readingTime(featured.body)}</span><span class="circle-arrow"><Icon name="arrow" size={25}/></span></div></div></a></section>}
  <section class="kaggle-entry shell" aria-labelledby="kaggle-entry-title">
    <div><span class="section-eyebrow-label">KAGGLE / FIELD NOTES</span><h2 id="kaggle-entry-title"><a href="/kaggle/">从一场比赛，到一种方法。</a></h2><p>{cases.length} 个比赛复盘，六类问题。从验证设计、失败实验和真实评分中，留下可复用的判断。</p></div>
    <a class="text-link" href="/kaggle/">进入 Kaggle 专栏 <Icon name="arrow" size={17}/></a>
  </section>
  <section class="research-entry shell" aria-labelledby="research-heading">
    <div><span class="section-eyebrow-label">RESEARCH / 2026.11.13</span><h2 id="research-heading"><a href="/data-agent-ontology/">Data Agent 与本体</a></h2><p>技术主线、关键证据与支撑材料。一份可追溯的研究记录。</p></div>
    <a class="text-link" href="/data-agent-ontology/">阅读报告 <Icon name="arrow" size={17}/></a>
  </section>
  <section class="latest-section shell" id="articles" aria-labelledby="latest-heading"><div class="section-heading"><div><span class="section-eyebrow-label">THOUGHTS, NOTES & EXPLORATIONS</span><h2 id="latest-heading">最近写下的<span class="heading-count">/{String(latest.length).padStart(2, '0')}</span></h2></div><a class="text-link" href="/posts/">全部文章 <Icon name="arrow" size={17}/></a></div><div class="filter-row" role="group" aria-label="按分类筛选文章">{categories.map((category, index) => <button type="button" class:list={['filter-button', { active: index === 0 }]} data-filter={category} aria-pressed={index === 0}>{category}<span>{category === '全部' ? latest.length : latest.filter(post => post.data.category === category).length}</span></button>)}<span class="filter-caption">一些想法，一点实践。</span></div><div class="post-grid">{latest.map((post, index) => <PostCard post={post} index={index}/>)}</div><p class="filter-empty" hidden>这个分类还没有文章，下次再来看看。</p></section>
  <section class="closing-note shell"><div class="note-symbol" aria-hidden="true">✳</div><div><span class="section-eyebrow-label">A LITTLE REMINDER</span><h2>慢慢来，<br class="mobile-break"/>好的想法值得等待。</h2><p>不追逐更新频率，只分享值得留下的东西。</p></div><a class="text-link" href="/rss.xml">通过 RSS 保持联系 <Icon name="arrow" size={18}/></a></section>
</BaseLayout>
