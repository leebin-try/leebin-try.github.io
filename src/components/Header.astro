---
import Icon from './Icon.astro';
import { SITE } from '@/config';
const pathname = Astro.url.pathname;
const nav = [{ label: '首页', href: '/' }, { label: '文章', href: '/posts/' }, { label: '手记', href: '/notes/' }, { label: '关于', href: '/about/' }];
---
<header class="site-header shell">
  <a class="wordmark" href="/" aria-label="BIN JOURNAL 首页"><span class="brand-flower" aria-hidden="true">✳</span><span>bin<span class="brand-dot">.</span></span><span class="wordmark-label">JOURNAL</span></a>
  <nav class="desktop-nav" aria-label="主导航">{nav.map(item => <a href={item.href} aria-current={(item.href === '/' ? pathname === '/' : pathname.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>)}</nav>
  <div class="header-actions">
    <button class="icon-button" type="button" data-search-open aria-label="搜索文章"><Icon name="search"/><span class="key-hint">⌘ K</span></button>
    <span class="action-separator"></span>
    <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="切换到深色模式"><span class="light-icon"><Icon name="moon"/></span><span class="dark-icon"><Icon name="sun"/></span></button>
    <a class="icon-button github-link" href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="访问 GitHub"><Icon name="github" size={19}/></a>
    <button class="icon-button mobile-menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-navigation" aria-label="打开导航"><Icon name="menu"/></button>
  </div>
</header>
<nav id="mobile-navigation" class="mobile-nav shell" aria-label="移动导航" hidden>{nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
