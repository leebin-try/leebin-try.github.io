---
import Icon from './Icon.astro';
import { SITE } from '@/config';
import { localeOf, localPath, translator } from '@/utils/i18n';
interface Props { fragments?: Record<string,string>; }
const { fragments } = Astro.props;
const pathname = Astro.url.pathname;
const languagePath = /^\/404(?:\.html)?\/?$/.test(pathname) ? '/' : pathname;
const locale = localeOf(pathname);
const t = translator(locale);
const nav = [{ label: t('首页','Home'), href: '/' }, { label: t('文章','Articles'), href: '/posts/' }, { label: 'Kaggle', href: '/kaggle/' }, { label: t('手记','Notes'), href: '/notes/' }, { label: t('关于','About'), href: '/about/' }].map(item => ({...item, href:localPath(item.href,locale)}));
---
<header class="site-header shell">
  <a class="wordmark" href={localPath('/',locale)} aria-label={t('BIN JOURNAL 首页','BIN JOURNAL home')}><span class="brand-flower" aria-hidden="true">✳</span><span>bin<span class="brand-dot">.</span></span><span class="wordmark-label">JOURNAL</span></a>
  <nav class="desktop-nav" aria-label={t('主导航','Main navigation')}>{nav.map(item => <a href={item.href} aria-current={(item.href === localPath('/',locale) ? pathname === item.href : pathname.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>)}</nav>
  <div class="header-actions">
    <nav class="language-switch" aria-label={t('切换语言','Language')}>
      <a href={localPath(languagePath,'en')} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined} data-language="en" data-fragments={locale === 'zh' ? JSON.stringify(fragments ?? {}) : '{}'}>EN</a><span aria-hidden="true">/</span><a href={localPath(languagePath,'zh')} lang="zh-CN" hreflang="zh-CN" aria-current={locale === 'zh' ? 'true' : undefined} data-language="zh" data-fragments={locale === 'en' ? JSON.stringify(fragments ?? {}) : '{}'}>中文</a>
    </nav>
    <button class="icon-button" type="button" data-search-open aria-label={t('搜索文章','Search articles')}><Icon name="search"/><span class="key-hint">⌘ K</span></button>
    <span class="action-separator"></span>
    <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label={t('切换到深色模式','Switch to dark mode')}><span class="light-icon"><Icon name="moon"/></span><span class="dark-icon"><Icon name="sun"/></span></button>
    <a class="icon-button github-link" href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label={t('访问 GitHub','Visit GitHub')}><Icon name="github" size={19}/></a>
    <button class="icon-button mobile-menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-navigation" aria-label={t('打开导航','Open navigation')}><Icon name="menu"/></button>
  </div>
</header>
<nav id="mobile-navigation" class="mobile-nav shell" aria-label={t('移动导航','Mobile navigation')} hidden>{nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
