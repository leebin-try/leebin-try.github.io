---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/config';
import { localeOf, localPath, translator } from '@/utils/i18n';
const locale = localeOf(Astro.url.pathname);
const t = translator(locale);
---
<BaseLayout title={t('关于','About')}><section class="about-page shell"><div class="about-intro"><div><span class="section-eyebrow-label">BEHIND THE JOURNAL</span><h1>{t('你好，','Hello,')}<br/>{t('很高兴你在这里','glad you are here')}<span class="accent-dot">.</span></h1><p class="about-lead">{t('把工具做简单，把思考留完整。','Simple tools. Carefully developed ideas.')}<br/>{t('在技术和生活之间，寻找自己的节奏。','Finding a rhythm between technology and everyday life.')}</p></div><div class="about-art"><img src="/art/slow.svg" alt={t('抽象的日光与阶梯','An original illustration of sunlight and steps')} width="800" height="560"/><span>MAKE ROOM<br/>FOR CURIOSITY.</span></div></div><div class="about-columns"><h2>{t('关于这处空间','About this space')}</h2><div class="prose"><p>{t('BIN / JOURNAL 是一处记录想法的数字空间。它可以放下技术实践、设计观察，也可以是一杯咖啡的时间。','BIN / JOURNAL is a digital space for working through ideas: technical experiments, design observations and moments from everyday life.')}</p><p>{t('我希望这里的文章清晰、有用，也保留一点温度。比起迅速给出答案，更愿意把问题想清楚，把过程记录下来。','The aim is clear, useful writing with a human voice. Understanding a question and recording the process matters more than rushing to an answer.')}</p><p class="demo-note">{t('当前页面是博客设计样稿，文字用于展示排版与阅读体验。正式上线前可以替换成你的个人介绍。','This retained sample biography demonstrates the page layout; it is not a verified personal profile.')}</p></div></div><div class="about-columns"><h2>{t('正在构建','Work in progress')}</h2><a class="project-link" href="https://github.com/leebin-try/ost" target="_blank" rel="noopener noreferrer"><span class="project-icon">&gt;_</span><div><h3>OST</h3><p>{t('基于 Rust 的 macOS 终端系统浏览器。','A Rust-based terminal system browser for macOS.')}</p></div><Icon name="arrow" size={24}/></a></div><div class="about-columns"><h2>{t('保持联系','Stay in touch')}</h2><div class="about-links"><a class="text-link" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={18}/></a><a class="text-link" href={localPath('/rss.xml',locale)}>{t('RSS 订阅','Subscribe via RSS')} <Icon name="rss" size={17}/></a></div></div></section></BaseLayout>
