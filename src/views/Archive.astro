---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts } from '@/utils/posts';
import { categories } from '@/config';
import { localeOf, translator, label } from '@/utils/i18n';
const locale = localeOf(Astro.url.pathname);
const t = translator(locale);
const posts = await getPosts(locale);
---
<BaseLayout title={t('全部文章','All articles')}>
<section class="listing-page shell"><div class="page-heading"><span class="section-eyebrow-label">THE ARCHIVE</span><h1>{t('一些思考，','Ideas, experiments,')}<br/>{t('一些正在发生的事','and work in progress')}<span class="accent-dot">.</span></h1><p>{t('关于技术、设计、生活、Kaggle 与数学的','Technology, design, everyday work, Kaggle and mathematics:')} {posts.length} {t('篇记录。示例文章会在正文中单独标注。','articles. Retained sample pieces are labelled in their text.')}</p></div><div class="filter-row" role="group" aria-label={t('按分类筛选文章','Filter articles by category')}>{categories.map((category,index) => <button type="button" class:list={['filter-button',{active:index===0}]} data-filter={category} aria-pressed={index===0}>{label(category,locale)}<span>{category==='全部'?posts.length:posts.filter(p=>p.data.category===category).length}</span></button>)}</div><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div><p class="filter-empty" hidden>{t('这个分类还没有文章。','No articles in this category yet.')}</p></section>
</BaseLayout>
