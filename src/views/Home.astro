---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts, postPath, formatDate, readingTime, coverSource, coverAlt } from '@/utils/posts';
import { categories } from '@/config';
import { localeOf, localPath, translator, label } from '@/utils/i18n';
import '@/styles/research-report.css';
import '@/styles/kaggle.css';
const locale = localeOf(Astro.url.pathname);
const t = translator(locale);
const posts = await getPosts(locale);
const featured = posts.find(p=>p.data.featured) ?? posts[0];
const latest = posts.filter(p=>p.id!==featured?.id).slice(0,6);
const cases = posts.filter(p=>p.data.kaggle?.kind==='case');
---
<BaseLayout>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-eyebrow"><span class="status-dot"></span> A PERSONAL JOURNAL <span class="hero-vol">EST. 2026 / VOL. 01</span></div>
    <div class="hero-content"><div><h1 id="hero-title">{t('保持好奇，','Stay curious,')}<br/>{t('持续','keep ')}<span class="hero-emphasis">{t('构建','building')}<svg viewBox="0 0 240 14" aria-hidden="true"><path d="M4 10Q110-2 236 6"/></svg></span>.</h1><div class="hero-bottom"><span class="hero-label">TECHNOLOGY</span><span class="little-cross">+</span><span class="hero-label">DESIGN</span><span class="little-cross">+</span><span class="hero-label">LIFE</span></div></div><div class="hero-intro"><span class="intro-symbol" aria-hidden="true">↘</span><p>{t('在代码与日常之间，','Between code and everyday work,')}<br/>{t('记录思考，分享发现。','a place to record ideas,')}<br/>{t('这里是一处缓慢生长的数字花园。','test them and share what holds up.')}</p><a class="text-link" href={localPath('/about/',locale)}>{t('很高兴认识你','Meet the person behind the notes')} <Icon name="arrow" size={17}/></a></div></div>
  </section>
  {featured && <section class="featured-section shell" aria-labelledby="featured-title"><div class="section-eyebrow"><span>THE FEATURED STORY</span><span>{t('精选','FEATURED')} · 01</span></div><a class="featured-story" href={postPath(featured)}><div class="featured-art"><img src={coverSource(featured)} class:list={{'editorial-cover':Boolean(featured.data.coverImage)}} alt={coverAlt(featured)} width="1000" height="760" fetchpriority="high"/></div><div class="featured-copy"><div class="featured-kicker"><span class="category"><i></i>{label(featured.data.category,locale)}</span>{featured.data.sample && <span class="sample-badge">{t('示例文章','Sample article')}</span>}</div><h2 id="featured-title">{featured.data.title}</h2><p>{featured.data.description}</p><div class="featured-bottom"><span>{formatDate(featured.data.date)}<span class="meta-sep">/</span>{readingTime(featured.body,locale)}</span><span class="circle-arrow"><Icon name="arrow" size={25}/></span></div></div></a></section>}
  <section class="kaggle-entry shell" aria-labelledby="kaggle-entry-title"><div><span class="section-eyebrow-label">KAGGLE / FIELD NOTES</span><h2 id="kaggle-entry-title"><a href={localPath('/kaggle/',locale)}>{t('从一场比赛，到一种方法。','From one competition to a reusable method.')}</a></h2><p>{cases.length} {t('个比赛复盘，六类问题。从验证设计、失败实验和真实评分中，留下可复用的判断。','case studies across six problem families. Validation design, failed experiments and actual scores inform the next decision.')}</p></div><a class="text-link" href={localPath('/kaggle/',locale)}>{t('进入 Kaggle 专栏','Explore Kaggle field notes')} <Icon name="arrow" size={17}/></a></section>
  <section class="research-entry shell" aria-labelledby="research-heading"><div><span class="section-eyebrow-label">RESEARCH / 2026.11.13</span><h2 id="research-heading"><a href={localPath('/data-agent-ontology/',locale)}>{t('Data Agent 与本体','Data agents and ontologies')}</a></h2><p>{t('技术主线、关键证据与支撑材料。一份可追溯的研究记录。','Technical approaches, key findings and traceable primary evidence.')}</p></div><a class="text-link" href={localPath('/data-agent-ontology/',locale)}>{t('阅读报告','Read the research report')} <Icon name="arrow" size={17}/></a></section>
  <section class="latest-section shell" id="articles" aria-labelledby="latest-heading"><div class="section-heading"><div><span class="section-eyebrow-label">THOUGHTS, NOTES & EXPLORATIONS</span><h2 id="latest-heading">{t('最近写下的','Recent writing')}<span class="heading-count">/{String(latest.length).padStart(2,'0')}</span></h2></div><a class="text-link" href={localPath('/posts/',locale)}>{t('全部文章','All articles')} <Icon name="arrow" size={17}/></a></div><div class="filter-row" role="group" aria-label={t('按分类筛选文章','Filter articles by category')}>{categories.map((category,index)=><button type="button" class:list={['filter-button',{active:index===0}]} data-filter={category} aria-pressed={index===0}>{label(category,locale)}<span>{category==='全部'?latest.length:latest.filter(p=>p.data.category===category).length}</span></button>)}<span class="filter-caption">{t('一些想法，一点实践。','Ideas put into practice.')}</span></div><div class="post-grid">{latest.map((post,index)=><PostCard post={post} index={index}/>)}</div><p class="filter-empty" hidden>{t('这个分类还没有文章，下次再来看看。','No recent articles in this category yet.')}</p></section>
  <section class="closing-note shell"><div class="note-symbol" aria-hidden="true">✳</div><div><span class="section-eyebrow-label">A LITTLE REMINDER</span><h2>{t('慢慢来，','Take your time.')}<br class="mobile-break"/>{t('好的想法值得等待。','Good ideas deserve attention.')}</h2><p>{t('不追逐更新频率，只分享值得留下的东西。','Share work worth keeping, rather than chase a publishing schedule.')}</p></div><a class="text-link" href={localPath('/rss.xml',locale)}>{t('通过 RSS 保持联系','Follow via RSS')} <Icon name="arrow" size={18}/></a></section>
</BaseLayout>
